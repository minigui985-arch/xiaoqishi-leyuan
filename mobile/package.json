{
  "name": "xiaoqishi-mobile",
  "version": "0.8.3",
  "private": true,
  "scripts": {
    "build:web": "node ../build-edgeone.cjs && node ../check-edgeone-deploy.cjs",
    "check:native": "node check-native.cjs",
    "sync:android": "npm run build:web && node cap-cli.cjs sync android",
    "sync:ios": "npm run build:web && node cap-cli.cjs sync ios",
